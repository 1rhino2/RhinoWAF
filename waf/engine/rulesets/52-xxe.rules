# xml external entity. detectxxe wants the doctype + entity + system/public
# shape, or an xinclude, so plain xml bodies are fine.

rule 944300 "xml external entity" {
    category xxe
    severity critical
    paranoia 1
    phase request-body
    targets body, xml
    op detectxxe
    tags xxe, cwe:611
}

# an internal entity declaration has no business in a request body either:
# billion laughs needs nothing external
rule 944310 "xml entity declaration in request" {
    category xxe
    severity critical
    paranoia 1
    phase request-body
    targets body, xml, args
    transforms urldecode, lower
    op rx <!doctype[^>]*\[[^\]]*<!entity\s+[a-z_][\w.-]*\s+
    tags xxe:entity
}

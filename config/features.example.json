{
  "version": "1.0.6",
  "server": {
    "listen": ":8080",
    "read_header_timeout_seconds": 10,
    "read_timeout_seconds": 30,
    "write_timeout_seconds": 60,
    "idle_timeout_seconds": 120,
    "max_header_bytes": 1048576,
    "trusted_proxies": []
  },
  "backend": {
    "proxy_url": "http://localhost:9000",
    "timeout_seconds": 30,
    "max_idle_conns": 100
  },
  "challenge_system": {
    "enabled": true,
    "default_type": "javascript",
    "pow_difficulty": 5,
    "whitelist_paths": ["/challenge/"],
    "require_for_paths": []
  },
  "fingerprinting": {
    "enabled": true,
    "max_ips_per_fingerprint": 5,
    "suspicious_threshold": 3,
    "max_age_hours": 24,
    "block_on_exceed": false,
    "require_client_data": false,
    "collection_rate_limit": 60
  },
  "websocket": {
    "enabled": true,
    "max_connections_per_ip": 10,
    "connection_rate_limit": 5,
    "connection_rate_window_seconds": 60,
    "max_message_size": 1048576,
    "message_rate_limit": 100,
    "message_rate_window_seconds": 60,
    "allowed_origins": [],
    "allow_origin_wildcard": true,
    "block_binary_messages": false,
    "max_violations": 5,
    "violation_ban_duration_minutes": 30,
    "idle_timeout_minutes": 5,
    "handshake_timeout_seconds": 10
  },
  "csrf": {
    "enabled": false,
    "double_submit": false,
    "secure_cookie": false,
    "token_ttl_hours": 1,
    "exempt_paths": ["/health", "/metrics", "/challenge/", "/fingerprint/", "/csrf/token", "/api/webhooks"]
  },
  "logging": {
    "enabled": true,
    "max_size_mb": 100,
    "max_age_days": 30,
    "max_backups": 3,
    "compress": true
  }
}
